{
  "name": "cartify",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://1obanov.github.io/cartify",
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^11.2.0",
    "lucide-react": "^0.482.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-datepicker": "^8.2.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-inlinesvg": "^4.1.3",
    "react-router-dom": "^7.1.1",
    "react-scripts": "5.0.1",
    "react-select": "^5.9.0",
    "react-toastify": "^11.0.2",
    "toastify-js": "^1.12.0",
    "web-vitals": "^2.1.4",
    "yup": "^1.6.1"
  },
  "scripts": {
    "start": "GENERATE_SOURCEMAP=false react-scripts start",
    "build": "GENERATE_SOURCEMAP=false react-scripts build",
    "check:styles": "prettier --check \"src/styles/**/*.scss\" && stylelint \"src/styles/**/*.scss\"",
    "format:styles": "prettier --write \"src/styles/**/*.scss\" && stylelint \"src/styles/**/*.scss\" --fix",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "gh-pages": "^6.3.0",
    "prettier": "^3.5.3",
    "sass": "^1.105.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "4.9"
  }
}
